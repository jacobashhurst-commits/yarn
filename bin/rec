#!/usr/bin/env bash
#
# Manual recording control. Nothing here ever starts on its own.
#
#   rec start [room|call]   begin recording (default: room)
#   rec stop                end recording, hand off, offer the popup
#   rec toggle [room|call]  one command for a single hotkey
#   rec status              is it recording, in which mode, for how long
#
# Modes:
#   room  everyone in a physical room on your microphone. This is the default.
#         One channel, and every turn is labelled "Unknown" until you name
#         voices after transcription.
#   call  a video call. Your voice is the laptop microphone. Everyone else is
#         everything this Mac is playing, so the headphones can stay on without
#         dropping to phone quality.
#
# Bind `rec toggle` to a hotkey (Raycast, Alfred, Shortcuts, skhd) or run it
# from a terminal. Recording only ever starts because you asked it to.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MA="${MA_BIN:-ma}"
RECORDER_LABEL="com.meetingarchive.recorder"

if ! command -v "$MA" >/dev/null 2>&1; then
  echo "rec: '$MA' not found on PATH. Install the package (pip install -e .)" >&2
  exit 1
fi

# Single source of truth for config: ask the Python side. That includes where
# the recorder binary is, because `ma` on PATH is usually a symlink into the
# virtualenv and its sibling directory does not contain ma-capture.
eval "$("$MA" rec-config)"
MA_CAPTURE="$MA_CAPTURE_BIN"
[[ -x "$MA_CAPTURE" ]] || \
  echo "rec: warning: recorder not found at $MA_CAPTURE; re-run 'pip install -e .'" >&2

STATE_FILE="$MA_ROOT/.recording"
STARTING_LOCK="$MA_ROOT/.recording-starting"
REQUEST_FILE="$MA_ROOT/.capture-request"
ERROR_FILE="$MA_ROOT/.capture-error"
mkdir -p "$MA_IN_PROGRESS" "$MA_LOGS"

# Everything a stop needs to say out loud ends up here. `rec stop` is usually
# launched from the menu bar, which discards stderr, so a refusal that is only
# printed is a refusal nobody ever sees -- which is exactly how two meetings
# once ended up stranded in in-progress with no explanation anywhere.
log_line() {
  printf '%s rec: %s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$*" >> "$MA_LOGS/rec.log"
}

# The message is passed as an argument rather than interpolated into the
# AppleScript, so a quote in an ffmpeg error cannot break the dialog.
alert() {
  nohup /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display alert "Meeting Archive" message (item 1 of argv) as critical' \
    -e 'end run' \
    -- "$1" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# The Mac's own permission window is the ask. This is only the reminder if
# that window was closed, and it is not an error.
note_permission() {
  local message="Turn on Yarn under Privacy & Security, Screen Recording. On a newer Mac that row is called Screen & System Audio Recording. Then press Headphones again."
  log_line "$message"
  if [[ -f "${STARTING_LOCK:-}" ]] && [[ "$(cat "$STARTING_LOCK" 2>/dev/null || true)" == "$$" ]]; then
    rm -f "$STARTING_LOCK"
  fi
  nohup /usr/bin/osascript \
    -e 'on run argv' \
    -e 'display dialog (item 1 of argv) buttons {"OK"} default button 1 with title "Yarn"' \
    -e 'end run' \
    -- "$message" >/dev/null 2>&1 &
  disown 2>/dev/null || true
  echo "rec: $message" >&2
  exit 1
}

die() {
  # A failed start must not leave the video-call recorder running. Stopping
  # when it was never started is a no-op.
  stop_call_audio
  if [[ -f "${STARTING_LOCK:-}" ]] && [[ "$(cat "$STARTING_LOCK" 2>/dev/null || true)" == "$$" ]]; then
    rm -f "$STARTING_LOCK"
  fi
  log_line "$*"
  alert "$*"
  echo "rec: $*" >&2
  exit 1
}

is_recording() {
  [[ -f "$STATE_FILE" ]] || return 1
  local pid
  pid="$(sed -n 1p "$STATE_FILE")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

do_start() {
  local mode="${1:-room}"
  if [[ "$mode" != "call" && "$mode" != "room" ]]; then
    die "unknown mode '$mode'; expected call or room"
  fi
  if is_recording; then
    die "already recording (started $(sed -n 4p "$STATE_FILE"))"
  fi
  # Headphones waits while the permission dialog is on screen. A second click
  # in that pause used to start another recorder and another dialog.
  if [[ -f "$STARTING_LOCK" ]]; then
    local starting
    starting="$(cat "$STARTING_LOCK" 2>/dev/null || true)"
    if [[ -n "$starting" ]] && kill -0 "$starting" 2>/dev/null; then
      # Not die(): that would stop the recorder this click is waiting on.
      log_line "a recording is already starting"
      alert "A recording is already starting. If System Settings is open, turn on Yarn, then press Headphones again."
      echo "rec: a recording is already starting" >&2
      exit 1
    fi
  fi
  printf '%s\n' "$$" > "$STARTING_LOCK"
  # A stale state file means a previous ffmpeg died. Recover, don't refuse.
  [[ -f "$STATE_FILE" ]] && rm -f "$STATE_FILE"

  local meeting_id raw started_at started_epoch
  meeting_id="$(date +%Y-%m-%dT%H-%M-%S)"
  raw="$MA_IN_PROGRESS/${meeting_id}__raw.wav"

  # Bluetooth headphones cannot play music-quality audio and run their own
  # microphone at the same time. Opening that microphone is what made the
  # headphones sound worse and left the recording of the video silent.
  # The voice stays on the laptop microphone. The other side is everything
  # the Mac is playing. Start that recorder first and only let it write once
  # the microphone is actually running, so the two files begin together.
  local device required_channels
  device="$MA_DEVICE_SELECTOR"
  required_channels="$MA_MIC_REQUIRED_CHANNELS"
  local -a playback=()
  if [[ "$mode" == "call" ]]; then
    eval "$("$MA" call-devices)"
    device="${MA_CALL_INPUT:-$device}"
    local count="${MA_CALL_OUTPUT_COUNT:-0}" i
    for ((i = 1; i <= count; i++)); do
      local name_var="MA_CALL_OUTPUT_$i"
      local name="${!name_var-}"
      [[ -n "$name" ]] && playback+=("$name")
    done
    required_channels=1
    [[ -n "$device" && "$device" != "-1" ]] || \
      die "Yarn could not find a microphone. Plug in the headphones, or set audio.device_name."
    log_line "video call microphone: $device"
    if ((${#playback[@]})); then
      log_line "video call playback: ${playback[*]}"
      start_call_audio "$MA_IN_PROGRESS/${meeting_id}__call.wav" "${playback[@]}"
    else
      log_line "video call playback: default output"
      start_call_audio "$MA_IN_PROGRESS/${meeting_id}__call.wav"
    fi
  else
    # A leftover video-call request must not make an in-room recording ask
    # for screen permission.
    rm -f "$CALL_AUDIO_REQUEST"
    [[ "$device" == "-1" || -z "$device" ]] && \
      die "audio device is not set. Run 'ma devices' and set audio.device_name."
  fi

  local pid
  # `die` inside a command substitution only kills the subshell, so the exit
  # status has to be checked here or a failed start would carry on with an
  # empty pid and look like a successful recording.
  if recorder_agent_installed; then
    pid="$(start_via_launchd "$raw" "$required_channels" "$device")" || exit 1
  else
    pid="$(start_directly "$raw" "$required_channels" "$device")" || exit 1
  fi
  [[ -n "$pid" ]] || die "recording did not start"

  if [[ "$mode" == "call" ]]; then
    release_call_audio "$MA_IN_PROGRESS/${meeting_id}__call.wav"
  fi

  # Start time means "ffmpeg is now receiving samples", not "the user
  # clicked". The device probe and launchd startup take a few seconds; counting
  # those would make every short recording appear to have lost audio.
  started_at="$(date +%Y-%m-%dT%H:%M:%S%z)"
  # Also stored as epoch seconds. The menu bar needs elapsed time, and
  # `date +%s` arithmetic is portable where parsing an ISO string back with
  # `date -j -f` is BSD-only and fails silently into a blank timer.
  started_epoch="$(date +%s)"

  printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$pid" "$meeting_id" "$raw" "$started_at" "$mode" "$started_epoch" > "$STATE_FILE"
  rm -f "$STARTING_LOCK"
  echo "recording: $meeting_id (mode: $mode)"
}


# Microphone permission on macOS belongs to the "responsible process", which
# for anything the menu bar launches is SwiftBar -- an app that declares no
# NSMicrophoneUsageDescription and so can never hold that permission. Rather
# than fail, macOS feeds it silence. Handing the capture to launchd makes the
# recorder responsible for itself, so the permission is asked for once and
# granted to this tool.
recorder_agent_installed() {
  launchctl print "gui/$(id -u)/$RECORDER_LABEL" >/dev/null 2>&1
}


# Both start paths run the same program, `ma-capture`, and it does its own
# device checks. The only difference is who its parent is, which is the whole
# point: launchd for the menu bar, the terminal for the command line.
write_request() {
  local raw="$1" required_channels="$2" device="$3"
  printf '%s\n%s\n%s\n%s\n%s\n' \
    "$raw" "$device" "$MA_SAMPLE_RATE" "$required_channels" "$MA_LOGS" \
    > "$REQUEST_FILE"
  rm -f "$ERROR_FILE"
}

# The recorder creates the wav only after the device has proven it is really
# delivering audio, so the file appearing is the signal that recording has
# begun. A failure arrives instead as a message in the error file.
#
# If this function decides the start failed, it must also stop the capture
# process. Otherwise the wav keeps growing, the next Start is a new meeting
# id, and the menu reports "recording(s) not saved" for a stub that is not
# a lost meeting.
await_capture() {
  local raw="$1" pid="$2" waited=0
  while (( waited < 150 )); do
    if [[ -s "$ERROR_FILE" ]]; then
      local message
      message="$(cat "$ERROR_FILE")"
      rm -f "$ERROR_FILE"
      abort_failed_start "$raw" "$pid"
      die "$message"
    fi
    [[ -s "$raw" ]] && return 0
    if ! kill -0 "$pid" 2>/dev/null; then
      # Fast failures can exit before the error file is visible on this
      # iteration. Wait once more rather than showing a generic "exited".
      sleep 0.2
      if [[ -s "$ERROR_FILE" ]]; then
        local late
        late="$(cat "$ERROR_FILE")"
        rm -f "$ERROR_FILE"
        abort_failed_start "$raw" "$pid"
        die "$late"
      fi
      abort_failed_start "$raw" "$pid"
      die "the recorder exited before it started recording; see $MA_LOGS/recorder.log"
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  abort_failed_start "$raw" "$pid"
  die "the recorder did not start within 15s; see $MA_LOGS/recorder.log"
}


abort_failed_start() {
  local raw="$1" pid="${2:-}"
  if recorder_agent_installed; then
    launchctl kill SIGINT "gui/$(id -u)/$RECORDER_LABEL" 2>/dev/null || true
  elif [[ -n "$pid" ]]; then
    kill -INT "$pid" 2>/dev/null || true
  fi
  sleep 0.3
  # Never published — there is no state file yet. A refused finalize is
  # different: that file is kept for `ma recover`.
  if [[ -n "$raw" && -f "$raw" && ! -f "$STATE_FILE" ]]; then
    rm -f "$raw"
  fi
}


start_via_launchd() {
  local raw="$1" required_channels="$2" device="$3"
  write_request "$raw" "$required_channels" "$device"

  launchctl kickstart -k "gui/$(id -u)/$RECORDER_LABEL" >/dev/null 2>&1 \
    || die "could not start the recorder job. Re-run ui/install-ui.sh."

  # The job takes a moment to appear, and its pid is the one `rec stop` has to
  # signal, so it has to be read back from launchd rather than assumed.
  local waited=0 pid="" last=""
  while (( waited < 100 )); do
    if [[ -s "$ERROR_FILE" ]]; then
      local message
      message="$(cat "$ERROR_FILE")"
      rm -f "$ERROR_FILE"
      abort_failed_start "$raw" "$pid"
      die "$message"
    fi
    pid="$(launchctl print "gui/$(id -u)/$RECORDER_LABEL" 2>/dev/null \
      | sed -n 's/^[[:space:]]*pid = \([0-9]*\).*/\1/p' | head -1)"
    # kickstart -k can briefly report the dying pid. Wait until it is stable
    # or await_capture will think the recorder exited.
    if [[ -n "$pid" && "$pid" == "$last" ]]; then
      break
    fi
    last="$pid"
    sleep 0.1
    waited=$((waited + 1))
  done
  [[ -n "$pid" ]] || die "the recorder job did not start; see $MA_LOGS/recorder.log"

  await_capture "$raw" "$pid"
  printf '%s' "$pid"
}


# Video-call audio is what the Mac is playing, not a BlackHole loopback.
# Yarn.app records it. A separate "Yarn System Audio" app is a second
# permission, and macOS asks for that app again every time it is launched.
# The grant already given to Yarn only covers code running inside Yarn.
# Recording in the room does not start this.
CALL_AUDIO_SRC="$SCRIPT_DIR/../ui/capture/YarnSystemAudio.swift"
CALL_AUDIO_APP="$HOME/Library/Application Support/Yarn/Yarn System Audio.app"
CALL_AUDIO_BIN="$CALL_AUDIO_APP/Contents/MacOS/YarnSystemAudio"
CALL_AUDIO_PID="$MA_ROOT/.call-audio"
CALL_AUDIO_LABEL="com.meetingarchive.systemaudio"
CALL_AUDIO_REQUEST="$MA_ROOT/.call-audio-request"
# Built into the download by bin/yarn-release. A friend's Mac has no Swift
# compiler, so the first video-call recording cannot compile this itself.
BUNDLED_CALL_AUDIO="$SCRIPT_DIR/../Yarn System Audio.app"

install_bundled_call_audio() {
  local bundled="$BUNDLED_CALL_AUDIO/Contents/MacOS/YarnSystemAudio"
  local parent tmp
  [[ -x "$bundled" ]] || return 1
  parent="$(dirname "$CALL_AUDIO_APP")"
  mkdir -p "$parent" || return 1
  tmp="$parent/Yarn System Audio.app.partial"
  rm -rf "$tmp"
  ditto "$BUNDLED_CALL_AUDIO" "$tmp" || { rm -rf "$tmp"; return 1; }
  rm -rf "$CALL_AUDIO_APP"
  mv "$tmp" "$CALL_AUDIO_APP"
}

ensure_call_audio_bin() {
  # Rebuilding this app changes its signature, and the Mac asks for permission
  # again. A helper that is already installed is left exactly as it is.
  if [[ -x "$CALL_AUDIO_BIN" && -f "$CALL_AUDIO_APP/Contents/Info.plist" ]]; then
    printf '%s\n' "$CALL_AUDIO_BIN"
    return 0
  fi
  if ! command -v swiftc >/dev/null 2>&1 || [[ ! -f "$CALL_AUDIO_SRC" ]]; then
    install_bundled_call_audio || return 1
    printf '%s\n' "$CALL_AUDIO_BIN"
    return 0
  fi
  mkdir -p "$CALL_AUDIO_APP/Contents/MacOS" "$MA_LOGS" || return 1
  cat > "$CALL_AUDIO_APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.systemaudio</string>
  <key>CFBundleName</key><string>Yarn System Audio</string>
  <key>CFBundleDisplayName</key><string>Yarn System Audio</string>
  <key>CFBundleExecutable</key><string>YarnSystemAudio</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>14.2</string>
  <key>LSUIElement</key><true/>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Yarn records a video call while you wear headphones. It records what this Mac is playing, on this Mac only.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Yarn records a video call while you wear headphones. It records the call audio, not the screen.</string>
</dict>
</plist>
PLIST
  if ! swiftc -target arm64-apple-macos14.2 -swift-version 5 -O \
      -o "$CALL_AUDIO_BIN.partial" "$CALL_AUDIO_SRC" \
      -framework ScreenCaptureKit -framework CoreMedia -framework CoreAudio \
      -framework Foundation \
      >>"$MA_LOGS/call-audio.log" 2>&1; then
    rm -f "$CALL_AUDIO_BIN.partial"
    install_bundled_call_audio || return 1
    printf '%s\n' "$CALL_AUDIO_BIN"
    return 0
  fi
  mv -f "$CALL_AUDIO_BIN.partial" "$CALL_AUDIO_BIN"
  codesign --force --sign - "$CALL_AUDIO_APP" >>"$MA_LOGS/call-audio.log" 2>&1 || true
  printf '%s\n' "$CALL_AUDIO_BIN"
}

# A second app asked for its own permission on every recording. Do not
# install that job again. Video-call audio is recorded by Yarn.
ensure_call_audio_agent() {
  local plist="$HOME/Library/LaunchAgents/$CALL_AUDIO_LABEL.plist"
  launchctl bootout "gui/$(id -u)/$CALL_AUDIO_LABEL" >/dev/null 2>&1 || true
  rm -f "$plist"
  return 0
}

start_call_audio() {
  local wav="$1"
  shift
  local -a devices=("$@")
  local err_file ready_file
  # A leftover job would show "Yarn System Audio" again. It is not used.
  launchctl bootout "gui/$(id -u)/$CALL_AUDIO_LABEL" >/dev/null 2>&1 || true
  rm -f "$HOME/Library/LaunchAgents/$CALL_AUDIO_LABEL.plist"
  killall YarnSystemAudio >/dev/null 2>&1 || true
  err_file="${wav}.error"
  ready_file="${wav}.ready"
  rm -f "$err_file" "$ready_file" "${wav}.go" "${wav}.stop" "${wav}.done" "$wav"
  mkdir -p "$(dirname "$wav")"
  # Device names are recorded for the log. Yarn records application audio
  # and does not open those devices.
  if ((${#devices[@]})); then
    printf '%s\n' "$wav" "${devices[@]}" > "$CALL_AUDIO_REQUEST"
  else
    printf '%s\n' "$wav" > "$CALL_AUDIO_REQUEST"
  fi
  printf '%s\n%s\n' "yarn" "$wav" > "$CALL_AUDIO_PID"

  local waited=0
  while (( waited < 150 )); do
    if [[ -s "$err_file" ]]; then
      local message
      message="$(cat "$err_file")"
      rm -f "$err_file"
      stop_call_audio
      # macOS will not show an Allow button for this. The switch in
      # Settings is the grant, and it sticks. A second alert on top of
      # that window is what made this look broken.
      if [[ "$message" == *Turn\ on\ Yarn* || "$message" == *Screen\ \&\ System\ Audio* ]]; then
        log_line "$message"
        open "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture" >/dev/null 2>&1 \
          || open "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension?Privacy_ScreenCapture" >/dev/null 2>&1 \
          || true
        if [[ -f "${STARTING_LOCK:-}" ]] && [[ "$(cat "$STARTING_LOCK" 2>/dev/null || true)" == "$$" ]]; then
          rm -f "$STARTING_LOCK"
        fi
        exit 1
      fi
      die "$message"
    fi
    if [[ -s "$ready_file" ]]; then
      log_line "video-call audio ready"
      return 0
    fi
    sleep 0.1
    waited=$((waited + 1))
  done
  stop_call_audio
  die "Yarn did not start the video-call audio. Open Yarn and press Headphones again."
}

stop_call_audio() {
  [[ -f "$CALL_AUDIO_PID" ]] || return 0
  local wav
  wav="$(sed -n 2p "$CALL_AUDIO_PID")"
  rm -f "$CALL_AUDIO_REQUEST"
  if [[ -n "$wav" ]]; then
    : > "${wav}.stop"
    local waited=0
    while [[ ! -f "${wav}.done" && $waited -lt 40 ]]; do
      sleep 0.1
      waited=$((waited + 1))
    done
    rm -f "${wav}.ready" "${wav}.go" "${wav}.error" "${wav}.stop" "${wav}.done"
  fi
  rm -f "$CALL_AUDIO_PID"
}

release_call_audio() {
  local wav="$1"
  [[ -f "$CALL_AUDIO_PID" ]] || return 0
  : > "${wav}.go"
}


# Used from a terminal, where the terminal itself holds the microphone
# permission and launchd is unnecessary.
start_directly() {
  local raw="$1" required_channels="$2" device="$3"
  write_request "$raw" "$required_channels" "$device"

  nohup "$MA_CAPTURE" "$REQUEST_FILE" >>"$MA_LOGS/rec.log" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true

  await_capture "$raw" "$pid"
  printf '%s' "$pid"
}


do_stop() {
  [[ -f "$STATE_FILE" ]] || die "not recording"

  local pid meeting_id raw started_at mode started_epoch expected_duration
  pid="$(sed -n 1p "$STATE_FILE")"
  meeting_id="$(sed -n 2p "$STATE_FILE")"
  raw="$(sed -n 3p "$STATE_FILE")"
  started_at="$(sed -n 4p "$STATE_FILE")"
  # Older state files have no mode line; default rather than fail a stop.
  mode="$(sed -n 5p "$STATE_FILE")"
  [[ -n "$mode" ]] || mode="room"
  started_epoch="$(sed -n 6p "$STATE_FILE")"
  if [[ "$started_epoch" =~ ^[0-9]+$ ]]; then
    expected_duration=$(( $(date +%s) - started_epoch ))
  else
    expected_duration=0
  fi

  # SIGINT, not SIGKILL: the capture process finishes the wav header on the
  # way out. Prefer launchctl when the job is launchd-managed — plain kill
  # usually works, but abort_failed_start already uses this path for the
  # same reason, and Stop should match.
  if kill -0 "$pid" 2>/dev/null; then
    if recorder_agent_installed; then
      launchctl kill SIGINT "gui/$(id -u)/$RECORDER_LABEL" 2>/dev/null \
        || kill -INT "$pid" 2>/dev/null || true
    else
      kill -INT "$pid" 2>/dev/null || true
    fi
    local waited=0
    while kill -0 "$pid" 2>/dev/null && [[ $waited -lt 20 ]]; do
      sleep 0.5
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "rec: capture did not exit cleanly, forcing" >&2
      log_line "capture pid $pid ignored SIGINT; sending SIGKILL"
      if recorder_agent_installed; then
        launchctl kill SIGKILL "gui/$(id -u)/$RECORDER_LABEL" 2>/dev/null \
          || kill -9 "$pid" 2>/dev/null || true
      else
        kill -9 "$pid" 2>/dev/null || true
      fi
      sleep 1
    fi
  fi
  # Finish the video-call wav before finalize reads it. The microphone stop
  # above already returned, so this only waits out the last buffers.
  stop_call_audio
  rm -f "$STATE_FILE"

  [[ -s "$raw" ]] || die "capture file is empty: $raw"

  # Splits the channels and publishes the manifest. The watcher takes it from
  # here; this command does not transcribe and does not block.
  #
  # Stop is nearly always clicked in the menu bar, which throws stderr away, so
  # a refusal has to be captured and put on screen. Without this, a rejected
  # recording just vanished: no inbox entry, no progress, no error.
  local finalized errors
  errors="$(mktemp -t rec-finalize)"
  if finalized="$("$MA" finalize "$raw" --started-at "$started_at" --mode "$mode" \
      --expected-duration "$expected_duration" 2>"$errors")"; then
    cat "$errors" >> "$MA_LOGS/rec.log"
    if [[ "$mode" == "call" ]] && grep -q "CALL_AUDIO_SILENT" "$errors"; then
      alert "The recording was saved, but Yarn did not hear the audio this Mac was playing. Turn on Yarn under System Settings, Privacy & Security, Screen Recording. On a newer Mac that row is called Screen & System Audio Recording. Then start the video call recording again."
    fi
    rm -f "$errors"
    log_line "saved $finalized"
    echo "saved: $finalized"
  else
    cat "$errors" >> "$MA_LOGS/rec.log"
    # The log lines carry a timestamp prefix; the message does not.
    local message
    message="$(sed -n 's/^[0-9-]* [0-9:,]* ERROR *[^:]*: //p' "$errors" | tail -1)"
    [[ -n "$message" ]] || message="$(tail -1 "$errors")"
    rm -f "$errors"
    log_line "finalize refused $meeting_id: $message"
    alert "$meeting_id was not saved.

$message"
    echo "rec: $message" >&2
    exit 1
  fi

  # Fire and forget. Dismissing this, or never seeing it, changes nothing.
  if [[ -x "$SCRIPT_DIR/meeting-popup" ]]; then
    nohup "$SCRIPT_DIR/meeting-popup" "$finalized" >/dev/null 2>&1 &
    disown || true
  fi
}

do_status() {
  if is_recording; then
    echo "recording $(sed -n 2p "$STATE_FILE") since $(sed -n 4p "$STATE_FILE")" \
         "(mode: $(sed -n 5p "$STATE_FILE" || echo room))"
  else
    echo "not recording"
    [[ -f "$STATE_FILE" ]] && echo "(stale state file present; 'rec start' will clear it)"
  fi
}

case "${1:-}" in
  start)  do_start "${2:-room}" ;;
  stop)   do_stop ;;
  toggle) if is_recording; then do_stop; else do_start "${2:-room}"; fi ;;
  status) do_status ;;
  *) echo "usage: rec {start|stop|toggle|status} [room|call]" >&2; exit 2 ;;
esac

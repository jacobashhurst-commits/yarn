#!/usr/bin/env bash
# Build the Dock app and leave it running.
#
#   bin/yarn-dock            build, install, and open the window
#   bin/yarn-dock --install  same, and open quietly at login
#
# The menu bar stays. This is the icon in the Dock.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SWIFT_SRC="$REPO_DIR/ui/dock/YarnDock.swift"
MARK="$REPO_DIR/meeting_archive/assets/yarn-mark.png"
APP_DIR="${YARN_DOCK_APP:-$HOME/Applications/Yarn.app}"
APP_BIN="$APP_DIR/Contents/MacOS/Yarn"
RES="$APP_DIR/Contents/Resources"

MA_BIN="${MA_BIN:-}"
if [[ -z "$MA_BIN" ]]; then
  if [[ -x "$REPO_DIR/.venv/bin/ma" ]]; then
    MA_BIN="$REPO_DIR/.venv/bin/ma"
  else
    MA_BIN="$(command -v ma || true)"
  fi
fi
[[ -n "$MA_BIN" && -x "$MA_BIN" ]] || { echo "yarn-dock: ma is missing" >&2; exit 1; }

REC="${YARN_REC:-$REPO_DIR/bin/rec}"
[[ -x "$REC" ]] || { echo "yarn-dock: rec is missing at $REC" >&2; exit 1; }

MA_ROOT="${MA_ROOT:-}"
if [[ -z "$MA_ROOT" ]]; then
  MA_ROOT="$("$MA_BIN" rec-config | sed -n 's/^MA_ROOT="\(.*\)"$/\1/p')"
fi
[[ -n "$MA_ROOT" ]] || { echo "yarn-dock: could not read the archive root" >&2; exit 1; }

command -v swiftc >/dev/null 2>&1 || { echo "yarn-dock: swiftc is required (Xcode command line tools)" >&2; exit 1; }
[[ -f "$MARK" ]] || { echo "yarn-dock: logo is missing at $MARK" >&2; exit 1; }

# Replacing a running binary fails, and a stale Dock icon would be the old app.
osascript -e 'tell application "Yarn" to quit' >/dev/null 2>&1 || true
sleep 0.4

mkdir -p "$APP_DIR/Contents/MacOS" "$RES"

cat > "$APP_DIR/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.yarn</string>
  <key>CFBundleName</key><string>Yarn</string>
  <key>CFBundleDisplayName</key><string>Yarn</string>
  <key>CFBundleExecutable</key><string>Yarn</string>
  <key>CFBundleIconFile</key><string>Yarn</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.3</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# Draw the mark at its real shape onto a white square. sips -z would
# stretch the wide logo to fill the tile, which is the squashed icon.
ICONSET="$(mktemp -d)/Yarn.iconset"
mkdir -p "$ICONSET"
MASTER="$(mktemp -d)/master.png"
swiftc -o "$(dirname "$MASTER")/make-icon" -framework AppKit - <<'SWIFT'
import AppKit
let mark = NSImage(contentsOf: URL(fileURLWithPath: CommandLine.arguments[1]))!
let side = 1024
let rep = NSBitmapImageRep(
    bitmapDataPlanes: nil,
    pixelsWide: side,
    pixelsHigh: side,
    bitsPerSample: 8,
    samplesPerPixel: 4,
    hasAlpha: true,
    isPlanar: false,
    colorSpaceName: .deviceRGB,
    bytesPerRow: 0,
    bitsPerPixel: 0
)!
NSGraphicsContext.saveGraphicsState()
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
NSColor.white.setFill()
NSRect(x: 0, y: 0, width: side, height: side).fill()
let aspect = mark.size.width / max(mark.size.height, 1)
let width = CGFloat(side) * 0.72
let height = width / aspect
mark.draw(
    in: NSRect(x: (CGFloat(side) - width) / 2, y: (CGFloat(side) - height) / 2, width: width, height: height),
    from: .zero,
    operation: .sourceOver,
    fraction: 1
)
NSGraphicsContext.restoreGraphicsState()
let png = rep.representation(using: .png, properties: [:])!
try! png.write(to: URL(fileURLWithPath: CommandLine.arguments[2]))
SWIFT
"$(dirname "$MASTER")/make-icon" "$MARK" "$MASTER"
sips -z 16 16 "$MASTER" --out "$ICONSET/icon_16x16.png" >/dev/null
sips -z 32 32 "$MASTER" --out "$ICONSET/icon_16x16@2x.png" >/dev/null
sips -z 32 32 "$MASTER" --out "$ICONSET/icon_32x32.png" >/dev/null
sips -z 64 64 "$MASTER" --out "$ICONSET/icon_32x32@2x.png" >/dev/null
sips -z 128 128 "$MASTER" --out "$ICONSET/icon_128x128.png" >/dev/null
sips -z 256 256 "$MASTER" --out "$ICONSET/icon_128x128@2x.png" >/dev/null
sips -z 256 256 "$MASTER" --out "$ICONSET/icon_256x256.png" >/dev/null
sips -z 512 512 "$MASTER" --out "$ICONSET/icon_256x256@2x.png" >/dev/null
sips -z 512 512 "$MASTER" --out "$ICONSET/icon_512x512.png" >/dev/null
sips -z 1024 1024 "$MASTER" --out "$ICONSET/icon_512x512@2x.png" >/dev/null
iconutil -c icns "$ICONSET" -o "$RES/Yarn.icns"
rm -rf "$ICONSET" "$(dirname "$MASTER")"

cp -f "$MARK" "$RES/yarn-mark.png"
cat > "$RES/paths.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>root</key><string>$MA_ROOT</string>
  <key>rec</key><string>$REC</string>
  <key>ma</key><string>$MA_BIN</string>
</dict>
</plist>
PLIST

swiftc -parse-as-library -O -o "$APP_BIN.partial" \
  "$SWIFT_SRC" "$(dirname "$SWIFT_SRC")/YarnChat.swift" -framework AppKit
mv -f "$APP_BIN.partial" "$APP_BIN"

if [[ "${1:-}" == "--install" ]]; then
  LABEL="com.meetingarchive.dock"
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-g</string>
    <string>$APP_DIR</string>
    <string>--</args</string>
    <string>--background</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST_EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  sleep 0.3
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
fi

# Open in front so the icon is in the Dock and the window is there to look at.
open "$APP_DIR"
echo "Yarn is in the Dock ($APP_DIR)"

#!/usr/bin/env bash
# Build the Dock app and leave it running.
#
#   bin/yarn-dock            build, install, and open the window
#   bin/yarn-dock --install  same, and open quietly at login
#
# The menu bar stays. This is the icon in the Dock.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SWIFT_SRC="$REPO_DIR/ui/dock/YarnDock.swift"
MARK="$REPO_DIR/meeting_archive/assets/yarn-mark.png"
APP_DIR="${YARN_DOCK_APP:-$HOME/Applications/Yarn.app}"
APP_BIN="$APP_DIR/Contents/MacOS/Yarn"
RES="$APP_DIR/Contents/Resources"

MA_BIN="${MA_BIN:-}"
if [[ -z "$MA_BIN" ]]; then
  if [[ -x "$REPO_DIR/.venv/bin/ma" ]]; then
    MA_BIN="$REPO_DIR/.venv/bin/ma"
  else
    MA_BIN="$(command -v ma || true)"
  fi
fi
[[ -n "$MA_BIN" && -x "$MA_BIN" ]] || { echo "yarn-dock: ma is missing" >&2; exit 1; }

REC="${YARN_REC:-$REPO_DIR/bin/rec}"
[[ -x "$REC" ]] || { echo "yarn-dock: rec is missing at $REC" >&2; exit 1; }

MA_ROOT="${MA_ROOT:-}"
if [[ -z "$MA_ROOT" ]]; then
  MA_ROOT="$("$MA_BIN" rec-config | sed -n 's/^MA_ROOT="\(.*\)"$/\1/p')"
fi
[[ -n "$MA_ROOT" ]] || { echo "yarn-dock: could not read the archive root" >&2; exit 1; }

[[ -f "$MARK" ]] || { echo "yarn-dock: logo is missing at $MARK" >&2; exit 1; }
# A normal Mac has no Swift compiler. The download includes Yarn.app already
# built. Compiling is for this checkout, where the source may be newer.

# Replacing a running binary fails, and a stale Dock icon would be the old app.
osascript -e 'tell application "Yarn" to quit' >/dev/null 2>&1 || true
sleep 0.4

mkdir -p "$APP_DIR/Contents/MacOS" "$RES"

cat > "$APP_DIR/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.yarn</string>
  <key>CFBundleName</key><string>Yarn</string>
  <key>CFBundleDisplayName</key><string>Yarn</string>
  <key>CFBundleExecutable</key><string>Yarn</string>
  <key>CFBundleIconFile</key><string>Yarn</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.3</string>
  <key>CFBundleVersion</key><string>0.3</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

cp -f "$MARK" "$RES/yarn-mark.png"
cat > "$RES/paths.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>root</key><string>$MA_ROOT</string>
  <key>rec</key><string>$REC</string>
  <key>ma</key><string>$MA_BIN</string>
</dict>
</plist>
PLIST

BUNDLED="$REPO_DIR/Yarn.app/Contents/MacOS/Yarn"
if command -v swiftc >/dev/null 2>&1 && [[ -f "$SWIFT_SRC" ]]; then
  "$REPO_DIR/bin/yarn-icon" "$MARK" "$APP_DIR"
  swiftc -target arm64-apple-macos13.0 -parse-as-library -O -o "$APP_BIN.partial" \
    "$SWIFT_SRC" "$(dirname "$SWIFT_SRC")/YarnChat.swift" \
    "$(dirname "$SWIFT_SRC")/YarnMenu.swift" \
    "$REPO_DIR/ui/welcome/YarnWelcome.swift" -framework AppKit
  mv -f "$APP_BIN.partial" "$APP_BIN"
elif [[ -x "$BUNDLED" ]]; then
  cp -f "$BUNDLED" "$APP_BIN"
  if [[ -f "$REPO_DIR/Yarn.app/Contents/Resources/Yarn.icns" ]]; then
    cp -f "$REPO_DIR/Yarn.app/Contents/Resources/Yarn.icns" "$RES/Yarn.icns"
  fi
else
  echo "Yarn could not add an Applications icon on this Mac. The menu bar still works." >&2
  exit 0
fi

if [[ "${1:-}" == "--install" ]]; then
  LABEL="com.meetingarchive.dock"
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-g</string>
    <string>$APP_DIR</string>
    <string>--args</string>
    <string>--background</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST_EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  sleep 0.3
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
fi

# Spotlight only offers an app it has been shown. Register the bundle so
# Command-Space and typing Yarn opens this one.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$LSREGISTER" ]]; then
  "$LSREGISTER" -f "$APP_DIR" >/dev/null 2>&1 || true
fi

# A running Yarn keeps the old binary. Quit it so the menu bar icon is this build.
osascript -e 'tell application "Yarn" to quit' >/dev/null 2>&1 || true
sleep 0.4
open "$APP_DIR"
echo "Yarn is in the Dock ($APP_DIR)"

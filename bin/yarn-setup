#!/usr/bin/env bash
#
# Open the Yarn Setup window. Non-tech path: double-click later; for now run
# this from the checkout. `--cli` skips the window and prints the same steps.
#
#   bin/yarn-setup
#   bin/yarn-setup --cli

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
xattr -cr "$REPO_DIR" 2>/dev/null || true
# A double-clicked command does not see Homebrew. Look there before deciding
# this Mac has no usable Python.
export PATH="/Library/Developer/CommandLineTools/usr/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
SWIFT_SRC="$REPO_DIR/ui/setup/YarnSetup.swift"
APP_DIR="$HOME/Library/Application Support/Yarn/Yarn Setup.app"
APP_BIN="$APP_DIR/Contents/MacOS/YarnSetup"

python_ok() {
  [[ -n "${1:-}" && -x "$1" ]] || return 1
  # A Mac with no developer tools has a stub at /usr/bin/python3. Running it
  # opens an installer and this command exits, so the person has to start
  # Yarn Setup again after the download. Skip the stub and install Python
  # ourselves, then keep going.
  if [[ "$1" == /usr/bin/python3 ]] && ! xcode-select -p >/dev/null 2>&1; then
    return 1
  fi
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' \
    >/dev/null 2>&1
}

host_python() {
  local c path
  for c in python3.12 python3.13 python3.11 python3; do
    path="$(command -v "$c" 2>/dev/null || true)"
    if python_ok "$path"; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

uv_python() {
  local uvbin path
  uvbin="$(command -v uv 2>/dev/null || true)"
  if [[ -z "$uvbin" && -x "$HOME/Library/Application Support/Yarn/bin/uv" ]]; then
    uvbin="$HOME/Library/Application Support/Yarn/bin/uv"
  fi
  [[ -n "$uvbin" ]] || return 1
  path="$("$uvbin" python find 3.12 2>/dev/null | tail -1 || true)"
  if python_ok "$path"; then
    printf '%s\n' "$path"
    return 0
  fi
  return 1
}

install_python() {
  # A fresh Mac often has only /usr/bin/python3, which is 3.9 and has no
  # tomllib. Installing 3.12 here keeps that from becoming "Setup stopped".
  echo "This Mac's Python is too old for Yarn. Installing Python 3.12. It stays on this Mac." >&2
  if [[ "$(uname -m)" != "arm64" ]]; then
    echo "Yarn Setup is Apple Silicon only. Intel Macs are not supported." >&2
    exit 1
  fi
  local bindir="$HOME/Library/Application Support/Yarn/bin"
  local uvbin="$bindir/uv"
  mkdir -p "$bindir"
  if [[ ! -x "$uvbin" ]]; then
    local tmp found
    tmp="$(mktemp -d)"
    if ! curl -fsSL -o "$tmp/uv.tar.gz" \
      "https://github.com/astral-sh/uv/releases/latest/download/uv-aarch64-apple-darwin.tar.gz"; then
      echo "Yarn needs Python 3.11 or newer, and downloading it did not work." >&2
      rm -rf "$tmp"
      exit 1
    fi
    tar -xzf "$tmp/uv.tar.gz" -C "$tmp"
    found="$(find "$tmp" -type f -name uv | head -1)"
    if [[ -z "$found" ]]; then
      echo "Yarn needs Python 3.11 or newer, and downloading it did not work." >&2
      rm -rf "$tmp"
      exit 1
    fi
    install -m 755 "$found" "$uvbin"
    rm -rf "$tmp"
  fi
  if ! "$uvbin" python install 3.12 >&2; then
    echo "Yarn needs Python 3.11 or newer, and installing it did not work." >&2
    exit 1
  fi
  "$uvbin" python find 3.12 2>/dev/null | tail -1 || true
}

PYTHON="$(host_python || true)"
if [[ -z "$PYTHON" ]]; then
  PYTHON="$(uv_python || true)"
fi
if [[ -z "$PYTHON" ]]; then
  PYTHON="$(install_python)"
fi
if ! python_ok "$PYTHON"; then
  echo "Yarn needs Python 3.11 or newer, and installing it did not work." >&2
  exit 1
fi

ensure_window_tools() {
  export PATH="/Library/Developer/CommandLineTools/usr/bin:$PATH"
  command -v swiftc >/dev/null 2>&1 && return 0
  if xcode-select -p >/dev/null 2>&1; then
    return 1
  fi
  echo "Yarn needs a one-time macOS install before the window can open." >&2
  echo "A Mac window will ask to install the tools. Click Install." >&2
  echo "Leave this window open. Yarn continues on its own when that finishes." >&2
  xcode-select --install >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 360); do
    export PATH="/Library/Developer/CommandLineTools/usr/bin:$PATH"
    if command -v swiftc >/dev/null 2>&1; then
      echo "Tools are in. Opening Yarn Setup." >&2
      return 0
    fi
    if (( i % 12 == 0 )); then
      echo "Still waiting for the macOS tools. Leave this window open." >&2
    fi
    sleep 5
  done
  echo "The tools did not finish. Continuing in this window." >&2
  return 1
}

if [[ "${1:-}" == "--cli" ]]; then
  export PYTHONPATH="$REPO_DIR"
  export PATH="$REPO_DIR/.venv/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
  exec "$PYTHON" -m meeting_archive.setup --repo "$REPO_DIR"
fi

build_app() {
  command -v swiftc >/dev/null 2>&1 || return 1
  mkdir -p "$APP_DIR/Contents/MacOS" || return 1
  cat > "$APP_DIR/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.setup</string>
  <key>CFBundleName</key><string>Yarn Setup</string>
  <key>CFBundleDisplayName</key><string>Setup</string>
  <key>CFBundleExecutable</key><string>YarnSetup</string>
  <key>CFBundleIconFile</key><string>Yarn</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.2</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>Yarn records meetings you start, on this Mac only.</string>
</dict>
</plist>
PLIST
  mkdir -p "$APP_DIR/Contents/Resources" || return 1
  cp -f "$REPO_DIR/meeting_archive/assets/yarn-mark.png" \
    "$APP_DIR/Contents/Resources/yarn-mark.png" || return 1
  "$REPO_DIR/bin/yarn-icon" "$REPO_DIR/meeting_archive/assets/yarn-mark.png" "$APP_DIR" "Setup" || return 1
  swiftc -parse-as-library -O -o "$APP_BIN.partial" \
    "$SWIFT_SRC" "$REPO_DIR/ui/welcome/YarnWelcome.swift" \
    -framework AppKit >/dev/null 2>&1 || return 1
  mv -f "$APP_BIN.partial" "$APP_BIN"
}

# The release zip already contains this app, built for Apple Silicon.
# A Mac with no Xcode, Homebrew, or Python can open it. Compiling here
# would stop and ask them to install developer tools first.
# In that zip the app sits inside .yarn/, with the program.
BUNDLED="$REPO_DIR/Yarn Setup.app"
if [[ ! -x "$BUNDLED/Contents/MacOS/YarnSetup" ]]; then
  PARENT="$(cd "$REPO_DIR/.." && pwd)"
  if [[ -x "$PARENT/Yarn Setup.app/Contents/MacOS/YarnSetup" ]]; then
    BUNDLED="$PARENT/Yarn Setup.app"
  fi
fi
if [[ -x "$BUNDLED/Contents/MacOS/YarnSetup" ]]; then
  xattr -cr "$BUNDLED" 2>/dev/null || true
  exec open -n "$BUNDLED" --args --repo "$REPO_DIR" --python "$PYTHON"
fi

if [[ ! -x "$APP_BIN" || "$SWIFT_SRC" -nt "$APP_BIN" ]]; then
  if ! command -v swiftc >/dev/null 2>&1; then
    ensure_window_tools || true
  fi
  if ! build_app; then
    echo "yarn-setup: could not build the window; running in the terminal instead" >&2
    export PYTHONPATH="$REPO_DIR"
    export PATH="$REPO_DIR/.venv/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
    exec "$PYTHON" -m meeting_archive.setup --repo "$REPO_DIR"
  fi
fi

exec open -n "$APP_DIR" --args --repo "$REPO_DIR" --python "$PYTHON"

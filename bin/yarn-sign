#!/usr/bin/env bash
#
# Sign a Yarn app. Notarize a zip once the Apple Developer Program is paid.
#
# With no Developer ID Application certificate this signs ad-hoc, which is
# what a local build needs today. The first certificate in the login
# keychain, or YARN_CODESIGN_IDENTITY, switches the same command over:
# hardened runtime and a secure timestamp, which is what notarization
# accepts. Gatekeeper on a downloaded zip still needs the notary ticket.
#
#   bin/yarn-sign "Yarn.app"
#   bin/yarn-sign --notarize dist/Yarn.Setup.Apple.Silicon.zip
#
#   YARN_CODESIGN_IDENTITY   exact certificate name, or "-" to force ad-hoc
#   YARN_NOTARY_PROFILE      keychain profile name (default: yarn-notary)
#   YARN_SKIP_NOTARIZE=1     sign only; yarn-release honours this

set -euo pipefail

PROFILE="${YARN_NOTARY_PROFILE:-yarn-notary}"

developer_identity() {
  if [[ -n "${YARN_CODESIGN_IDENTITY:-}" ]]; then
    printf '%s' "$YARN_CODESIGN_IDENTITY"
    return
  fi
  local found count
  found="$(security find-identity -v -p codesigning 2>/dev/null \
    | sed -n 's/.*"\(Developer ID Application:[^"]*\)".*/\1/p' || true)"
  count="$(printf '%s\n' "$found" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [[ "$count" == "0" ]]; then
    printf '%s' "-"
    return
  fi
  if [[ "$count" != "1" ]]; then
    echo "More than one Developer ID Application certificate is installed." >&2
    echo "Set YARN_CODESIGN_IDENTITY to the one Yarn should use:" >&2
    printf '%s\n' "$found" >&2
    exit 1
  fi
  printf '%s' "$found"
}

sign_app() {
  local app="$1"
  local identity
  identity="$(developer_identity)"
  if [[ ! -d "$app" ]]; then
    echo "yarn-sign: not an app bundle: $app" >&2
    exit 1
  fi
  xattr -cr "$app" 2>/dev/null || true
  if [[ "$identity" == "-" ]]; then
    codesign --force --sign - "$app"
    echo "yarn-sign: ad-hoc $app"
    return
  fi
  # runtime + timestamp are required before Apple will notarize the zip.
  codesign --force --options runtime --timestamp --sign "$identity" "$app"
  codesign --verify --deep --strict "$app"
  echo "yarn-sign: developer-id $app"
}

notarize_file() {
  local target="$1"
  if [[ ! -e "$target" ]]; then
    echo "yarn-sign: nothing to notarize at $target" >&2
    exit 1
  fi
  if ! xcrun notarytool history --keychain-profile "$PROFILE" >/dev/null 2>&1; then
    echo "yarn-sign: no notary credentials in the keychain profile '$PROFILE'." >&2
    echo "After the membership is active, store them once:" >&2
    echo "  xcrun notarytool store-credentials $PROFILE --apple-id YOUR_APPLE_ID --team-id YOUR_TEAM_ID --password YOUR_APP_SPECIFIC_PASSWORD" >&2
    exit 2
  fi
  xcrun notarytool submit "$target" --keychain-profile "$PROFILE" --wait
  # stapler cannot attach a ticket to a zip. The ticket has to go inside
  # each app, or a Mac with no network still hits the unidentified-developer
  # prompt. Deepest app first, so a nested Yarn.app is finished before the
  # Setup app that contains it.
  case "$target" in
    *.app)
      xcrun stapler staple "$target"
      ;;
    *.zip)
      local stage app
      stage="$(mktemp -d)"
      unzip -q "$target" -d "$stage"
      # Only the app people double-click. Stapling the nested Yarn.app
      # writes CodeResources into it, and the Setup signature then fails
      # because that file was not part of the seal.
      app="$(find "$stage" -mindepth 2 -maxdepth 2 -name '*.app' -type d -print -quit)"
      if [[ -n "$app" ]]; then
        xcrun stapler staple "$app"
      fi
      local root
      root="$(find "$stage" -mindepth 1 -maxdepth 1 -type d -print -quit)"
      rm -f "$target"
      COPYFILE_DISABLE=1 ditto -c -k --norsrc --keepParent "$root" "$target"
      rm -rf "$stage"
      ;;
  esac
  echo "yarn-sign: notarized $target"
}

case "${1:-}" in
  --notarize)
    if [[ -z "${2:-}" ]]; then
      echo "usage: yarn-sign --notarize <zip-or-app>" >&2
      exit 1
    fi
    notarize_file "$2"
    ;;
  "")
    echo "usage: yarn-sign <App.app> | yarn-sign --notarize <file>" >&2
    exit 1
    ;;
  *)
    sign_app "$1"
    ;;
esac

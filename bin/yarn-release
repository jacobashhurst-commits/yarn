#!/usr/bin/env bash
#
# Build the zip people download from the Yarn page.
# It is the installer folder, not the whole source tree. Models are still
# fetched by Yarn Setup after this zip is opened. That is deliberate.
#
#   bin/yarn-release
#   # writes dist/Yarn.Setup.Apple.Silicon.zip

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STAGE="$(mktemp -d)"
NAME="Yarn.Setup.Apple.Silicon"
ROOT="$STAGE/$NAME"
OUT="$REPO_DIR/dist/$NAME.zip"

mkdir -p "$ROOT" "$REPO_DIR/dist"

# The folder people open should show two things: this note and the command.
# The Setup app and the program live in a hidden folder, so Finder does not
# put them next to the note.
INNER="$ROOT/.yarn"
mkdir -p "$INNER"
cp -f "$REPO_DIR/Yarn Setup.command" "$REPO_DIR/Start here.txt" "$ROOT/"

copy() {
  local src="$1"
  mkdir -p "$INNER/$(dirname "$src")"
  cp -R "$REPO_DIR/$src" "$INNER/$src"
}

for path in \
  "README.md" \
  "pyproject.toml" \
  "uv.lock" \
  "requirements.txt" \
  "config.example.toml" \
  "meeting_archive" \
  "bin" \
  "ui"
do
  copy "$path"
done

find "$ROOT" \( -name '__pycache__' -o -name '.DS_Store' -o -name '._*' \) -print0 \
  | while IFS= read -r -d '' path; do
      rm -rf "$path"
    done
find "$ROOT" -name '*.pyc' -delete || true
chmod +x "$ROOT/Yarn Setup.command" "$INNER"/bin/*

# Ship the Setup window already built. Otherwise the first double-click
# needs Xcode's compiler, which a normal Mac does not have.
APP="$INNER/Yarn Setup.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.setup</string>
  <key>CFBundleName</key><string>Yarn Setup</string>
  <key>CFBundleDisplayName</key><string>Setup</string>
  <key>CFBundleExecutable</key><string>YarnSetup</string>
  <key>CFBundleIconFile</key><string>Yarn</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.2</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>Yarn records meetings you start, on this Mac only.</string>
</dict>
</plist>
PLIST
cp -f "$REPO_DIR/meeting_archive/assets/yarn-mark.png" \
  "$APP/Contents/Resources/yarn-mark.png"
# minos follows the SDK unless this is set. Built on a newer Mac, Launch
# Services then refuses the app on an older one (-10825) before any window.
swiftc -target arm64-apple-macos13.0 -parse-as-library -O -o "$APP/Contents/MacOS/YarnSetup" \
  "$REPO_DIR/ui/setup/YarnSetup.swift" \
  "$REPO_DIR/ui/welcome/YarnWelcome.swift" \
  -framework AppKit
"$REPO_DIR/bin/yarn-icon" "$REPO_DIR/meeting_archive/assets/yarn-mark.png" "$APP" Setup
xattr -cr "$APP" 2>/dev/null || true

# Same for the Applications icon. paths.plist is rewritten on the person's
# Mac during Setup, so this copy does not contain this machine's archive.
YARN="$INNER/Yarn.app"
mkdir -p "$YARN/Contents/MacOS" "$YARN/Contents/Resources"
cat > "$YARN/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.meetingarchive.yarn</string>
  <key>CFBundleName</key><string>Yarn</string>
  <key>CFBundleDisplayName</key><string>Yarn</string>
  <key>CFBundleExecutable</key><string>Yarn</string>
  <key>CFBundleIconFile</key><string>Yarn</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.3</string>
  <key>CFBundleVersion</key><string>0.3</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Yarn records a video call while you wear headphones. It records what this Mac is playing, on this Mac only. Recording in the room does not use this.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Yarn records a video call while you wear headphones. It records the call audio, not the screen. Recording in the room does not use this.</string>
</dict>
</plist>
PLIST
cp -f "$REPO_DIR/meeting_archive/assets/yarn-mark.png" \
  "$YARN/Contents/Resources/yarn-mark.png"
swiftc -target arm64-apple-macos13.0 -parse-as-library -O -o "$YARN/Contents/MacOS/Yarn" \
  "$REPO_DIR/ui/dock/YarnDock.swift" \
  "$REPO_DIR/ui/dock/YarnChat.swift" \
  "$REPO_DIR/ui/dock/YarnMenu.swift" \
  "$REPO_DIR/ui/welcome/YarnWelcome.swift" \
  "$REPO_DIR/ui/capture/YarnSystemAudio.swift" \
  -framework AppKit -framework ScreenCaptureKit -framework CoreMedia \
  -framework CoreAudio -framework Foundation
"$REPO_DIR/bin/yarn-icon" "$REPO_DIR/meeting_archive/assets/yarn-mark.png" "$YARN"
# Sign the bundle, not the temporary linker output, so macOS treats this as
# Yarn. A linker signature names the file that was compiled and the screen
# recording grant then does not apply.
# Ad-hoc until a Developer ID Application certificate is in the keychain.
# bin/yarn-sign switches itself once that certificate exists.
"$REPO_DIR/bin/yarn-sign" "$APP"
YARN_SIGN="$("$REPO_DIR/bin/yarn-sign" "$YARN")"
echo "$YARN_SIGN"

rm -f "$OUT"
COPYFILE_DISABLE=1 ditto -c -k --norsrc --keepParent "$ROOT" "$OUT"
rm -rf "$STAGE"
if [[ "$YARN_SIGN" == *"developer-id"* && "${YARN_SKIP_NOTARIZE:-}" != "1" ]]; then
  "$REPO_DIR/bin/yarn-sign" --notarize "$OUT"
fi
echo "$OUT"

#!/usr/bin/env bash
#
# SwiftBar menu bar plugin. Generated by install-ui.sh with real paths baked
# in -- do not edit this copy, edit the template in the repo and reinstall.
#
# Refreshes every few seconds, so it reads the recording state straight off the
# filesystem rather than invoking Python. A 200ms interpreter start-up several
# times a minute would be a silly way to draw a menu bar icon.

export PATH="__BREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin"

MA_ROOT="__MA_ROOT__"
REC="__REC__"
MA="__MA_BIN__"
MARK="__MENU_MARK__"
# SwiftBar treats image= as base64. A file path draws a blank tile.
MARK_B64=""
if [[ -f "$MARK" ]]; then
  MARK_B64="$(base64 < "$MARK" | tr -d '\n')"
fi
# If install baked a stale path (e.g. a brew symlink that was never created),
# Start/Stop fail silently under SwiftBar (terminal=false). Surface it.
if [[ ! -x "$REC" ]]; then
  echo "Yarn"
  echo "---"
  echo "Yarn Setup did not finish | color=red"
  echo "Run Yarn Setup again from the download folder | color=#888888"
  exit 0
fi
STATE_FILE="$MA_ROOT/.recording"
TRANSCRIPTS="$MA_ROOT/transcripts"
INBOX="$MA_ROOT/recordings/inbox"
FAILED="$MA_ROOT/recordings/failed"
IN_PROGRESS="$MA_ROOT/recordings/in-progress"
PROCESS_STATUS="$MA_ROOT/.processing-status.json"
PROCESS_CONTROL="$MA_ROOT/.processing-control.json"
QUEUE_STATUS="$MA_ROOT/.queue-status.json"
QUEUE_LINES="$MA_ROOT/.queue-lines.txt"
SETTINGS="$MA_ROOT/.yarn-settings.json"

recording=false
meeting_id=""
mode=""
started_at=""
started_epoch=""
if [[ -f "$STATE_FILE" ]]; then
  pid="$(sed -n 1p "$STATE_FILE" 2>/dev/null)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    recording=true
    meeting_id="$(sed -n 2p "$STATE_FILE")"
    started_at="$(sed -n 4p "$STATE_FILE")"
    mode="$(sed -n 5p "$STATE_FILE")"
    started_epoch="$(sed -n 6p "$STATE_FILE")"
    [[ -n "$mode" ]] || mode="room"
  fi
fi

elapsed() {
  # rec writes the start time as epoch seconds precisely so this is plain
  # arithmetic. Parsing the ISO stamp back would need BSD-specific date flags
  # and would fail into a silently blank timer.
  [[ "$started_epoch" =~ ^[0-9]+$ ]] || { echo "--:--"; return; }
  local secs=$(( $(date +%s) - started_epoch ))
  (( secs < 0 )) && secs=0
  printf '%d:%02d' $(( secs / 60 )) $(( secs % 60 ))
}

count_files() { ls -1 "$1" 2>/dev/null | grep -c "$2" || true; }

json_raw() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  plutil -extract "$key" raw -o - "$file" 2>/dev/null || true
}

processing=false
phase=""
percent=0
detail=""
indeterminate=false
proc_title=""
proc_remaining=""
proc_current=""
proc_total=""
proc_id=""
proc_step=""
proc_steps=""
proc_eta=""
proc_length=""
expected_s=0
phase_started=0
now_epoch="$(date +%s)"
if [[ -f "$PROCESS_STATUS" ]]; then
  phase="$(json_raw "$PROCESS_STATUS" phase)"
  percent="$(json_raw "$PROCESS_STATUS" percent)"
  detail="$(json_raw "$PROCESS_STATUS" detail)"
  updated="$(json_raw "$PROCESS_STATUS" updated_epoch)"
  indeterminate="$(json_raw "$PROCESS_STATUS" indeterminate)"
  proc_title="$(json_raw "$PROCESS_STATUS" title)"
  proc_remaining="$(json_raw "$PROCESS_STATUS" remaining)"
  proc_current="$(json_raw "$PROCESS_STATUS" current)"
  proc_total="$(json_raw "$PROCESS_STATUS" total)"
  proc_id="$(json_raw "$PROCESS_STATUS" meeting_id)"
  proc_step="$(json_raw "$PROCESS_STATUS" step)"
  proc_steps="$(json_raw "$PROCESS_STATUS" steps)"
  proc_eta="$(json_raw "$PROCESS_STATUS" eta)"
  proc_length="$(json_raw "$PROCESS_STATUS" recording_length)"
  expected_s="$(json_raw "$PROCESS_STATUS" expected_s)"
  phase_started="$(json_raw "$PROCESS_STATUS" phase_started_epoch)"
  stale_after="$(json_raw "$PROCESS_STATUS" stale_after_epoch)"
  [[ "$expected_s" =~ ^[0-9]+$ ]] || expected_s=0
  [[ "$phase_started" =~ ^[0-9]+$ ]] || phase_started=0
  # Voice separation can run for hours without rewriting the status, so a
  # fixed 2h freshness window made a busy watcher look idle.
  if [[ -n "$phase" && "$updated" =~ ^[0-9]+$ ]]; then
    if (( now_epoch - updated < 7200 )) \
        || { [[ "$stale_after" =~ ^[0-9]+$ ]] && (( now_epoch < stale_after )); }; then
      processing=true
    fi
  fi
fi

# 4000 -> "1h 06m". Matches pipeline._fmt_span.
span() {
  local s="$1"
  [[ "$s" =~ ^[0-9]+$ ]] || s=0
  if (( s >= 3600 )); then
    printf '%dh %02dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  elif (( s >= 60 )); then
    printf '%dm' $(( s / 60 ))
  else
    printf '%ds' "$s"
  fi
}

# Live figures, recomputed every refresh rather than frozen at the moment the
# stage started.
phase_elapsed=0
(( phase_started > 0 )) && phase_elapsed=$(( now_epoch - phase_started ))
(( phase_elapsed < 0 )) && phase_elapsed=0
live_percent=""
live_eta=""
if [[ "$indeterminate" == "true" ]] && (( expected_s >= 1 )); then
  live_percent=$(( phase_elapsed * 100 / expected_s ))
  (( live_percent > 95 )) && live_percent=95
  left=$(( expected_s - phase_elapsed ))
  if (( left > 0 )); then
    live_eta="about $(span "$left") left (estimate from past meetings)"
  else
    live_eta="taking longer than usual, still working"
  fi
elif [[ -n "$proc_eta" ]]; then
  live_eta="$proc_eta"
fi

paused=false
if [[ -f "$PROCESS_CONTROL" ]]; then
  paused_flag="$(json_raw "$PROCESS_CONTROL" paused)"
  [[ "$paused_flag" == "true" || "$paused_flag" == "1" ]] && paused=true
fi

recognise="$(json_raw "$SETTINGS" recognise_known)"
meeting_language="$(json_raw "$SETTINGS" meeting_language)"
engine="$(json_raw "$SETTINGS" speaker_engine)"
retention="$(json_raw "$SETTINGS" audio_retention)"
summarize_when="$(json_raw "$SETTINGS" summarize_when)"
brief_on_login="$(json_raw "$SETTINGS" brief_on_login)"
brief_manual_count="$(json_raw "$SETTINGS" brief_manual_count)"
[[ "$brief_manual_count" =~ ^[0-9]+$ ]] || brief_manual_count=0
summary_model="$(json_raw "$SETTINGS" summary_model)"
[[ -n "$engine" ]] || engine="pyannote"
[[ -n "$retention" ]] || retention="1_week"
[[ -n "$summarize_when" ]] || summarize_when="after_meeting"

progress_bar() {
  local value="$1" width=18 bar="" i filled
  [[ "$value" =~ ^[0-9]+$ ]] || value=0
  filled=$(( value * width / 100 ))
  for ((i=0; i<width; i++)); do
    if (( i < filled )); then bar="${bar}█"; else bar="${bar}░"; fi
  done
  printf '%s' "$bar"
}

stage_line() {
  if [[ "$indeterminate" == "true" || ! "$percent" =~ ^[0-9]+$ ]]; then
    printf '%s%s' "$phase" "${detail:+: $detail}"
  else
    printf '%s %s%%%s' "$phase" "$percent" "${detail:+: $detail}"
  fi
}

short_phase() {
  case "$phase" in
    "Preparing audio") printf 'Preparing' ;;
    "Transcribing") printf 'Transcribing' ;;
    "Identifying speakers") printf 'Voices' ;;
    "Recognising known speakers") printf 'Recognising' ;;
    "Cleaning transcript") printf 'Cleaning' ;;
    "Saving transcript") printf 'Saving' ;;
    "Indexing"|"Indexing for search") printf 'Indexing' ;;
    "Writing summary") printf 'Summary' ;;
    *) printf '%s' "${phase:-Processing}" ;;
  esac
}

fraction() {
  if [[ "$proc_current" =~ ^[1-9][0-9]*$ && "$proc_total" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s/%s' "$proc_current" "$proc_total"
  fi
}

# A meeting id is 2026-09-29T10-31-30; the date and time are all that is
# readable at menu-bar size.
short_id() {
  local id="$1"
  printf '%s %s' "${id:5:5}" "$(printf '%s' "${id:11:5}" | tr '-' ':')"
}

# Epoch seconds to HH:MM. `date -r` is the BSD spelling and this only ever
# runs on macOS, but keep the fallback so a bad value prints nothing rather
# than the word "Invalid".
clock_of() {
  date -r "$1" '+%H:%M' 2>/dev/null || true
}

pending="$(count_files "$INBOX" '\.json$')"
queue_remaining="$(json_raw "$QUEUE_STATUS" remaining)"
queue_inbox="$(json_raw "$QUEUE_STATUS" inbox)"
queue_summaries="$(json_raw "$QUEUE_STATUS" summaries_pending)"
queue_blocker="$(json_raw "$QUEUE_STATUS" blocker)"
queue_last_id="$(json_raw "$QUEUE_STATUS" last_id)"
queue_updated="$(json_raw "$QUEUE_STATUS" last_finished_epoch)"
[[ "$queue_remaining" =~ ^[0-9]+$ ]] || queue_remaining="$pending"
[[ "$queue_inbox" =~ ^[0-9]+$ ]] || queue_inbox="$pending"
[[ "$queue_summaries" =~ ^[0-9]+$ ]] || queue_summaries=0
waiting="$queue_remaining"
if $processing && [[ "$proc_remaining" =~ ^[0-9]+$ ]]; then
  waiting="$proc_remaining"
fi

# ---- menu bar title ----
# The logo is the menu bar item. A live capture still wins the text beside it,
# and processing stays visible in the menu underneath.
menu_title() {
  local text="${1:-}"
  if [[ -n "$MARK_B64" ]]; then
    echo "${text} | templateImage=${MARK_B64}"
  else
    echo "${text:-Yarn}"
  fi
}
if $recording; then
  menu_title "$(elapsed)"
elif $processing; then
  frac="$(fraction)"
  stage="$(short_phase)"
  pct=""
  if [[ -n "$live_percent" ]]; then
    pct=" ~${live_percent}%"
  elif [[ "$indeterminate" != "true" && "$percent" =~ ^[0-9]+$ ]]; then
    pct=" ${percent}%"
  fi
  menu_title "${frac:+$frac }${stage}${pct}"
elif $paused; then
  menu_title "Paused"
elif [[ "$queue_remaining" =~ ^[0-9]+$ ]] && (( queue_remaining > 0 )); then
  menu_title "$queue_remaining"
else
  menu_title
fi

echo "---"
echo "Recording | size=12 color=#888888"
if $recording; then
  echo "Recording since ${started_at:-unknown} | size=11 color=#888888"
  if [[ "$mode" == "call" ]]; then
    echo "Headphones | size=11 color=#888888"
  else
    echo "In the room | size=11 color=#888888"
  fi
  echo "Stop recording | bash=/bin/bash param1=-c param2='export MA_BIN=\"$MA\"; exec \"$REC\" stop' terminal=false refresh=true"
else
  echo "Start recording, in the room | bash=/bin/bash param1=-c param2='export MA_BIN=\"$MA\"; exec \"$REC\" start room' terminal=false refresh=true"
  echo "Start recording, headphones | bash=/bin/bash param1=-c param2='export MA_BIN=\"$MA\"; exec \"$REC\" start call' terminal=false refresh=true"
fi

echo "---"
echo "Processing | size=12 color=#888888"
if $processing; then
  frac="$(fraction)"
  heading="Now: ${proc_title:-$(short_id "$proc_id")}"
  [[ -n "$proc_length" ]] && heading="$heading (${proc_length} recording)"
  if [[ -n "$frac" ]]; then
    heading="Meeting ${proc_current} of ${proc_total}: ${heading#Now: }"
  fi
  echo "$heading | size=12 color=#cc8800"
  step_text="${proc_step:-$phase}"
  echo "${step_text}, running $(span "$phase_elapsed") | size=11 color=#cc8800"
  [[ -n "$detail" ]] && echo "$detail | size=11 color=#888888"
  if [[ -n "$live_percent" ]]; then
    echo "$(progress_bar "$live_percent")  ~${live_percent}% | font=Menlo size=11 color=#cc8800"
  elif [[ "$indeterminate" != "true" && "$percent" =~ ^[0-9]+$ ]]; then
    echo "$(progress_bar "$percent")  ${percent}% | font=Menlo size=11 color=#cc8800"
  fi
  [[ -n "$live_eta" ]] && echo "$live_eta | size=11 color=#cc8800"
  [[ -n "$proc_steps" ]] && echo "$proc_steps | size=11 color=#888888"
elif $paused; then
  echo "Paused | size=11 color=#888888"
else
  # "Idle" on its own is unfalsifiable: it looks identical whether the queue
  # is empty or the watcher died hours ago. Naming the last meeting it
  # finished, and when, is what makes an idle state checkable at a glance.
  idle_line="Nothing to process"
  if [[ -n "$queue_last_id" ]]; then
    idle_line="Nothing to process. Last finished $(short_id "$queue_last_id")"
    if [[ "$queue_updated" =~ ^[1-9][0-9]*$ ]]; then
      idle_line="$idle_line at $(clock_of "$queue_updated")"
    fi
  fi
  echo "$idle_line | size=11 color=#888888"
fi
when_hint=""
case "$summarize_when" in
  evening) when_hint=" until evening" ;;
  manual) when_hint=" until you press Process" ;;
esac
if [[ "$queue_remaining" =~ ^[0-9]+$ ]] && (( queue_remaining > 0 )); then
  if $processing; then
    echo "Up next: ${queue_remaining} more | size=11 color=#888888"
  else
    echo "${queue_remaining} meeting(s) waiting${when_hint} | size=11 color=#cc8800"
  fi
  # One line per waiting meeting, written by the watcher (queue.py).
  if [[ -f "$QUEUE_LINES" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      echo "• ${line} | size=11 color=#888888"
    done < "$QUEUE_LINES"
  fi
  if (( queue_summaries > 0 )) && ! pgrep -xq ollama && ! pgrep -xq Ollama; then
    echo "Summaries need Ollama, which isn't running | size=11 color=#cc0000 bash=/usr/bin/open param1=-a param2=Ollama terminal=false"
  elif [[ -n "$queue_blocker" ]]; then
    echo "Summaries waiting: ${queue_blocker} | size=11 color=#cc0000"
  fi
  if ! $processing; then
    echo "Process waiting now | bash=\"$MA\" param1=process terminal=false refresh=true"
  fi
fi
if $paused; then
  echo "Resume processing | bash=\"$MA\" param1=resume terminal=false refresh=true"
elif $processing || [[ "$waiting" =~ ^[1-9][0-9]*$ ]]; then
  echo "Pause processing | bash=\"$MA\" param1=pause terminal=false refresh=true"
else
  # Nothing is running and nothing is queued, so a bare "Pause processing"
  # implied there was something to pause -- which is what made an idle menu
  # look like a stuck one. The action still has a purpose here (it stops the
  # next meeting being picked up), so it is relabelled rather than hidden.
  echo "Pause automatic processing | bash=\"$MA\" param1=pause terminal=false refresh=true"
fi

echo "---"
echo "Quick actions | size=12 color=#888888"
echo "Open Yarn | bash=/usr/bin/open param1=\"$HOME/Applications/Yarn.app\" terminal=false"
echo "Ask Yarn | bash=\"$MA\" param1=ask terminal=false refresh=true"
echo "Import recording | bash=\"$(dirname "$REC")/yarn-import\" param1=audio param2=\"$MA\" terminal=false refresh=true"
echo "Import transcript | bash=\"$(dirname "$REC")/yarn-import\" param1=transcript param2=\"$MA\" terminal=false refresh=true"
echo "Daily brief | bash=\"$MA\" param1=brief param2=--open param3=--force terminal=false refresh=true"
if [[ -f "$MA_ROOT/briefs/latest.html" ]]; then
  echo "Open last brief | bash=/usr/bin/open param1=\"$MA_ROOT/briefs/latest.html\" terminal=false"
fi
echo "Open library | bash=/bin/bash param1=-lc param2='$MA library --html >/dev/null; open \"$MA_ROOT/library.html\"' terminal=false refresh=true"
echo "Known speakers | bash=/bin/bash param1=-lc param2='$MA voices --html >/dev/null; open \"$MA_ROOT/speakers/library.html\"' terminal=false refresh=true"
echo "Open transcripts folder | bash=/usr/bin/open param1=\"$TRANSCRIPTS\" terminal=false"
echo "Open Ollama | bash=/usr/bin/open param1=-a param2=Ollama terminal=false"

# ---- archive state ----
transcripts="$(find "$TRANSCRIPTS" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')"
failed="$(count_files "$FAILED" '\.json$')"

echo "---"
if [[ "$transcripts" == "1" ]]; then
  echo "1 meeting archived | size=11 color=#888888"
else
  echo "$transcripts meetings archived | size=11 color=#888888"
fi
if [[ "$failed" -gt 0 ]]; then
  echo "$failed failed, audio kept | size=11 color=#cc0000 bash=/usr/bin/open param1=\"$MA_ROOT/logs\" terminal=false"
fi
# A raw capture sitting here while nothing is recording was never published.
# Short leftovers are failed Start clicks (the capture outlived the error
# dialog). Offer discard, not a terminal command.
if ! $recording; then
  stranded="$(count_files "$IN_PROGRESS" '__raw\.wav$')"
  if [[ "$stranded" -gt 0 ]]; then
    echo "$stranded recording(s) did not finish | size=11 color=#cc0000"
    echo "-- Discard aborted starts | bash=\"$MA\" param1=recover param2=--discard-aborted terminal=false refresh=true"
    echo "-- Show files | bash=/usr/bin/open param1=\"$IN_PROGRESS\" terminal=false"
  fi
fi

echo "---"
echo "Settings | size=12 color=#888888"
# The app stays English. This is the language of the next recording.
case "$meeting_language" in
  auto) language_label="Decide from the audio" ;;
  ja) language_label="Japanese" ;;
  zh) language_label="Chinese" ;;
  es) language_label="Spanish" ;;
  fr) language_label="French" ;;
  de) language_label="German" ;;
  ko) language_label="Korean" ;;
  *) language_label="English"; meeting_language="en" ;;
esac
echo "Meeting language: ${language_label} | size=11 color=#888888"
for pair in "en:English" "auto:Decide from the audio" "ja:Japanese" "zh:Chinese" "es:Spanish" "fr:French" "de:German" "ko:Korean"; do
  code="${pair%%:*}"
  label="${pair#*:}"
  mark=""
  [[ "$meeting_language" == "$code" ]] && mark="checked=true"
  echo "-- ${label} | bash=\"$MA\" param1=setting param2=meeting_language param3=${code} terminal=false refresh=true ${mark}"
done
# Missing means on. A new install does not ask again about a voice it already knows.
if [[ -z "$recognise" || "$recognise" == "true" || "$recognise" == "1" ]]; then
  echo "Recognise known speakers: On | bash=\"$MA\" param1=setting param2=recognise_known param3=off terminal=false refresh=true"
else
  echo "Recognise known speakers: Off | bash=\"$MA\" param1=setting param2=recognise_known param3=on terminal=false refresh=true"
fi
case "$engine" in
  sherpa) engine_label="Stable" ;;
  compare) engine_label="Compare both" ;;
  *) engine_label="Experimental" ;;
esac
echo "Voices: ${engine_label} | size=11 color=#617188"
pyannote_mark=""; sherpa_mark=""; compare_mark=""
case "$engine" in
  sherpa) sherpa_mark="checked=true" ;;
  compare) compare_mark="checked=true" ;;
  *) pyannote_mark="checked=true" ;;
esac
echo "-- Experimental | bash=\"$MA\" param1=setting param2=speaker_engine param3=pyannote terminal=false refresh=true ${pyannote_mark}"
echo "-- Stable | bash=\"$MA\" param1=setting param2=speaker_engine param3=sherpa terminal=false refresh=true ${sherpa_mark}"
echo "-- Compare both | bash=\"$MA\" param1=setting param2=speaker_engine param3=compare terminal=false refresh=true ${compare_mark}"
week_mark=""; month_mark=""; never_mark=""
case "$retention" in
  1_month|month) retention_label="1 month"; month_mark="checked=true" ;;
  never) retention_label="Never"; never_mark="checked=true" ;;
  *) retention_label="1 week"; week_mark="checked=true" ;;
esac
echo "Audio retention: ${retention_label} | size=11 color=#888888"
echo "-- 1 week | bash=\"$MA\" param1=setting param2=audio_retention param3=1_week terminal=false refresh=true ${week_mark}"
echo "-- 1 month | bash=\"$MA\" param1=setting param2=audio_retention param3=1_month terminal=false refresh=true ${month_mark}"
echo "-- Never | bash=\"$MA\" param1=setting param2=audio_retention param3=never terminal=false refresh=true ${never_mark}"
case "$summarize_when" in
  evening) summarize_label="Evening" ;;
  manual) summarize_label="Manual" ;;
  *) summarize_label="After each meeting" ;;
esac
echo "Process when: ${summarize_label} | size=11 color=#888888"
echo "-- After each meeting | bash=\"$MA\" param1=setting param2=summarize_when param3=after_meeting terminal=false refresh=true"
echo "-- Evening (when the laptop is free) | bash=\"$MA\" param1=setting param2=summarize_when param3=evening terminal=false refresh=true"
echo "-- Manual only | bash=\"$MA\" param1=setting param2=summarize_when param3=manual terminal=false refresh=true"
if [[ "$brief_on_login" == "true" || "$brief_on_login" == "1" ]]; then
  echo "Open brief at login: On | bash=\"$MA\" param1=setting param2=brief_on_login param3=off terminal=false refresh=true"
else
  echo "Open brief at login: Off | bash=\"$MA\" param1=setting param2=brief_on_login param3=on terminal=false refresh=true"
  if (( brief_manual_count >= 3 )); then
    echo "Tip: try Open brief at login after a few mornings | size=11 color=#888888"
  fi
fi
# Empty overlay means "whatever this Mac can run": 9B above 10 GB, 4B on a Neo.
# The watcher also rewrites a 9B setting down on an 8 GB machine.
mem_bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
can_accurate=false
if [[ "$mem_bytes" =~ ^[0-9]+$ ]] && (( mem_bytes > 10737418240 )); then
  can_accurate=true
fi
if [[ -z "$summary_model" ]]; then
  if $can_accurate; then summary_model="qwen3.5:9b"; else summary_model="qwen3.5:4b"; fi
fi
fast_mark=""; accurate_mark=""
case "$summary_model" in
  *9b*|accurate)
    quality_label="Accurate (9B)"
    accurate_mark="checked=true"
    ;;
  *)
    quality_label="Fast (4B)"
    fast_mark="checked=true"
    ;;
esac
echo "Summary model: ${quality_label} | size=11 color=#617188"
echo "-- Fast (4B) | bash=\"$MA\" param1=setting param2=summary_model param3=fast terminal=false refresh=true ${fast_mark}"
if $can_accurate; then
  echo "-- Accurate (9B) | bash=\"$MA\" param1=setting param2=summary_model param3=accurate terminal=false refresh=true ${accurate_mark}"
else
  echo "-- Accurate (9B) needs about 16 GB | disabled=true size=11 color=#617188"
fi
echo "Also search from another app | size=11 color=#617188"
echo "-- Claude | bash=\"$MA\" param1=connect param2=claude terminal=false refresh=true"
echo "-- Cursor | bash=\"$MA\" param1=connect param2=cursor terminal=false refresh=true"
echo "-- ChatGPT | bash=\"$MA\" param1=connect param2=chatgpt terminal=false refresh=true"
echo "Diagnostics | bash=\"$MA\" param1=doctor terminal=true"
echo "Logs | bash=/usr/bin/open param1=\"$MA_ROOT/logs\" terminal=false"
echo "Refresh | refresh=true"
